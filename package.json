{
  "name": "stepquest",
  "version": "1.3.0",
  "description": "A pixel-art fantasy RPG that turns your daily Garmin steps into adventures.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --experimental-sqlite --test test/*.test.cjs",
    "check:garmin": "node scripts/check-garmin.cjs",
    "test:electron": "electron . --smoke-test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "test:release": "node --experimental-sqlite scripts/release-audit.cjs"
  },
  "keywords": [],
  "author": "StepQuest",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "it.stepquest.desktop",
    "productName": "StepQuest",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.role-playing-games",
      "identity": "-",
      "icon": "build/stepquest-icon.png",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "build/stepquest-icon.png",
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/stepquest-icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Game",
      "maintainer": "Gladiak <Gladiak@users.noreply.github.com>"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/verify-package.cjs"
  },
  "homepage": "https://github.com/Gladiak/StepQuest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gladiak/StepQuest.git"
  },
  "bugs": {
    "url": "https://github.com/Gladiak/StepQuest/issues"
  }
}
